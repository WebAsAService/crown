---
/**
 * LandingLayout - Reusable layout for VSL-style marketing landing pages
 *
 * This layout provides a consistent structure for marketing landing pages with:
 * - Responsive hero section with media support
 * - Problem/outcome sections
 * - FAQ accordion
 * - Final CTA section
 *
 * Usage:
 * Import this layout and pass a pageConfig object with your content.
 * See src/pages/landing/clarity-check.astro for a complete example.
 */

import Layout from "@layouts/Layout.astro";

interface CTAButton {
  label: string;
  href: string;
}

interface VideoConfig {
  type: "local" | "external";
  src: string;
  poster?: string;
}

interface ContentBlock {
  title: string;
  body: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

export interface PageConfig {
  badge?: string;
  heroTitle: string;
  heroSubtitle: string;
  heroBody: string;
  primaryCta: CTAButton;
  secondaryCta?: CTAButton;
  video?: VideoConfig;
  problemBlocks?: ContentBlock[];
  outcomeBlocks?: ContentBlock[];
  faq?: FAQItem[];
}

interface Props {
  config: PageConfig;
  title?: string;
  description?: string;
}

const { config, title = "Crown Acquisition Group", description = "" } = Astro.props;

// Analytics tracking function (placeholder - can be replaced with actual analytics)
const trackingScript = `
  function trackCTA(location) {
    if (window.gtag) {
      gtag('event', 'cta_click', {
        page: 'landing_clarity_check',
        location: location
      });
    }
  }
`;
---

<Layout title={title} description={description} clientTheme="theme-crown-new">
  <div class="min-h-screen bg-gradient-to-b from-primary-50 to-white">
    <!-- Hero Section -->
    <section class="section px-4 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        {config.badge && (
          <div class="text-center mb-6">
            <span class="inline-block px-4 py-2 bg-secondary-100 text-secondary-800 rounded-full text-sm font-semibold">
              {config.badge}
            </span>
          </div>
        )}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          <!-- Hero Content -->
          <div class="space-y-6">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary-900 leading-tight">
              {config.heroTitle}
            </h1>

            <h2 class="text-xl md:text-2xl text-primary-700 font-medium">
              {config.heroSubtitle}
            </h2>

            <div class="prose prose-lg text-gray-700 whitespace-pre-line">
              {config.heroBody}
            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-4">
              <a
                href={config.primaryCta.href}
                class="btn-primary text-center px-8 py-4 text-lg font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all"
                onclick="trackCTA('hero')"
              >
                {config.primaryCta.label}
              </a>

              {config.secondaryCta && (
                <a
                  href={config.secondaryCta.href}
                  class="btn-outline text-center px-8 py-4 text-lg font-semibold rounded-lg border-2 border-primary-600 text-primary-600 hover:bg-primary-50 transition-all"
                >
                  {config.secondaryCta.label}
                </a>
              )}
            </div>
          </div>

          <!-- Media Block -->
          {config.video && (
            <div class="w-full">
              {config.video.type === "local" ? (
                <video
                  class="w-full rounded-lg shadow-2xl"
                  controls
                  playsinline
                  preload="metadata"
                  poster={config.video.poster}
                >
                  <source src={config.video.src} type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              ) : (
                <div class="relative w-full" style="padding-bottom: 56.25%;">
                  <iframe
                    class="absolute top-0 left-0 w-full h-full rounded-lg shadow-2xl"
                    src={config.video.src}
                    title="Video"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Problem Section -->
    {config.problemBlocks && config.problemBlocks.length > 0 && (
      <section class="section px-4 py-16 bg-white">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {config.problemBlocks.map((block) => (
              <div class="space-y-4">
                <h3 class="text-2xl font-bold text-primary-900">
                  {block.title}
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  {block.body}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Outcome Section -->
    {config.outcomeBlocks && config.outcomeBlocks.length > 0 && (
      <section class="section px-4 py-16 bg-primary-50">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
            {config.outcomeBlocks.map((block) => (
              <div class="card p-6 space-y-4 hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-primary-900">
                  {block.title}
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  {block.body}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ Section -->
    {config.faq && config.faq.length > 0 && (
      <section class="section px-4 py-16 bg-white">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary-900 text-center mb-12">
            Frequently Asked Questions
          </h2>

          <div class="space-y-4">
            {config.faq.map((item, index) => (
              <details class="group bg-gray-50 rounded-lg p-6 hover:bg-gray-100 transition-colors">
                <summary class="cursor-pointer font-semibold text-lg text-primary-900 flex justify-between items-center">
                  <span>{item.question}</span>
                  <span class="text-secondary-600 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-4 text-gray-700 leading-relaxed">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Final CTA Section -->
    <section class="section px-4 py-20 bg-gradient-to-r from-primary-700 to-primary-900 text-white">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <h2 class="text-3xl md:text-4xl font-bold">
          {config.heroTitle}
        </h2>
        <p class="text-xl text-primary-100">
          {config.heroSubtitle}
        </p>
        <div class="pt-4">
          <a
            href={config.primaryCta.href}
            class="inline-block bg-secondary-400 hover:bg-secondary-500 text-primary-900 font-bold px-10 py-5 rounded-lg text-xl shadow-xl hover:shadow-2xl transition-all"
            onclick="trackCTA('bottom')"
          >
            {config.primaryCta.label}
          </a>
        </div>
      </div>
    </section>
  </div>

  <script set:html={trackingScript}></script>
</Layout>

<style>
  details > summary {
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
