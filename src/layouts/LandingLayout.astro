---
/**
 * LandingLayout.astro
 *
 * Reusable layout for VSL-style marketing landing pages.
 * This layout is config-driven - all content comes from a pageConfig object
 * passed as props, making it easy to create new landing pages by duplicating
 * and modifying the config.
 *
 * Usage:
 * 1. Create a new page in src/pages/landing/your-page.astro
 * 2. Define a pageConfig object with your content
 * 3. Import this layout and pass the config as props
 * 4. The layout handles all rendering logic
 */

import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

// TypeScript interface for type safety
interface CTA {
  label: string;
  href: string;
}

interface Video {
  type: "local" | "external";
  src: string;
  poster?: string;
}

interface Block {
  title: string;
  body: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface CEOMessage {
  heading: string;
  name: string;
  body: string;
  video?: Video;
  image?: string;
}

interface Props {
  badge?: string;
  heroTitle: string;
  heroSubtitle: string;
  heroBody: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  video?: Video;
  problemBlocks?: Block[];
  ceoMessage?: CEOMessage;
  outcomeBlocks?: Block[];
  faq?: FAQItem[];
  pageTitle?: string;
  pageDescription?: string;
}

const {
  badge,
  heroTitle,
  heroSubtitle,
  heroBody,
  primaryCta,
  secondaryCta,
  video,
  problemBlocks = [],
  ceoMessage,
  outcomeBlocks = [],
  faq = [],
  pageTitle = heroTitle,
  pageDescription = heroSubtitle,
} = Astro.props;

// Analytics tracking function (uses gtag if available)
const trackCTAClick = (location: string) => {
  if (typeof window !== 'undefined' && (window as any).gtag) {
    (window as any).gtag('event', 'cta_click', {
      page: 'landing_clarity_check',
      location: location
    });
  }
};
---

<Layout title={pageTitle} description={pageDescription} clientTheme="theme-crown-new">
  <Header
    logo="/images/clients/crown/crown.png"
    bgColor="bg-primary-800"
    textColor="text-secondary-400"
    hoverColor="text-secondary-700"
    showFontsLink={false}
  />

  <main class="bg-primary-950">
    <!-- Hero Section -->
    <section class="py-12 md:py-20 bg-primary-900">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <!-- Left: Hero Content -->
          <div>
            {badge && (
              <div class="mb-6">
                <span class="inline-block px-6 py-2 bg-transparent border border-secondary-500 text-secondary-500 rounded-full text-sm md:text-base font-semibold uppercase tracking-wider text-center">
                  {badge}
                </span>
              </div>
            )}

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
              {heroTitle}
            </h1>

            <p class="text-xl md:text-2xl text-secondary-400 mb-6 font-semibold">
              {heroSubtitle}
            </p>

            <div class="prose prose-invert max-w-none mb-8">
              <p class="text-white/80 text-base md:text-lg whitespace-pre-line">
                {heroBody}
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={primaryCta.href}
                class="inline-block px-8 py-4 bg-secondary-500 hover:bg-secondary-600 text-primary-900 font-bold rounded-lg transition-colors text-center text-lg"
                onclick={`if(typeof gtag !== 'undefined') { gtag('event', 'cta_click', { page: 'landing_clarity_check', location: 'hero' }); }`}
              >
                {primaryCta.label}
              </a>
            </div>
          </div>

          <!-- Right: Media Block -->
          {video && (
            <div>
              <div class="space-y-4">
                {video.type === "local" ? (
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    poster={video.poster}
                    class="w-full rounded-lg shadow-2xl"
                  >
                    <source src={video.src} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                ) : (
                  <div class="relative w-full" style="padding-bottom: 56.25%;">
                    <iframe
                      src={video.src}
                      class="absolute top-0 left-0 w-full h-full rounded-lg shadow-2xl"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}
                <p class="text-center text-white/80 text-sm md:text-base">
                  Takes around three minutes. Unlocks an expert led-clarity session.
                </p>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Problem Section -->
    {problemBlocks.length > 0 && (
      <section class="py-16 md:py-24 bg-primary-950">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="mb-12 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
              Common Challenges
            </h2>
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            {problemBlocks.map((block) => (
              <div class="bg-primary-900 p-8 rounded-lg border-2 border-secondary-500">
                <h3 class="text-xl md:text-2xl font-bold text-secondary-400 mb-4">
                  {block.title}
                </h3>
                <p class="text-white/80 text-base md:text-lg">
                  {block.body}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CEO Message Section -->
    {ceoMessage && (
      <section class="py-16 md:py-24 bg-primary-900">
        <div class="container mx-auto px-4 max-w-6xl">
          <!-- Heading - always first on mobile and desktop -->
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 md:mb-8 text-center md:text-left">
            {ceoMessage.heading}
          </h2>

          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">
            <!-- Left: Message Content (order-2 on mobile, default on desktop) -->
            <div class="order-2 md:order-none">
              <div class="space-y-4 text-white/80 text-base md:text-lg">
                {ceoMessage.body.split('\n\n').map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

              <p class="mt-6 text-white/80 text-base md:text-lg italic">
                {ceoMessage.name}
              </p>
            </div>

            <!-- Right: Image or Video (order-1 on mobile to appear after heading, default on desktop) -->
            <div class="order-1 md:order-none flex justify-center items-center">
              {ceoMessage.image ? (
                <img
                  src={ceoMessage.image}
                  alt={ceoMessage.name}
                  class="w-full max-w-sm rounded-lg shadow-2xl"
                />
              ) : ceoMessage.video ? (
                ceoMessage.video.type === "local" ? (
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    poster={ceoMessage.video.poster}
                    class="w-full rounded-lg shadow-2xl"
                  >
                    <source src={ceoMessage.video.src} type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                ) : (
                  <div class="relative w-full" style="padding-bottom: 56.25%;">
                    <iframe
                      src={ceoMessage.video.src}
                      class="absolute top-0 left-0 w-full h-full rounded-lg shadow-2xl"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                )
              ) : (
                <div class="w-full bg-primary-800 rounded-lg shadow-2xl flex items-center justify-center" style="padding-bottom: 56.25%; position: relative;">
                  <div class="absolute inset-0 flex items-center justify-center">
                    <p class="text-white/50 text-lg">Media placeholder</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Outcome / Value Section -->
    {outcomeBlocks.length > 0 && (
      <section class="py-16 md:py-24 bg-primary-950">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="mb-12 text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              <span class="text-secondary-400">Take the Clarity Check</span>
              <br />
              <span class="text-white">What You'll Get</span>
            </h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8 mb-12">
            {outcomeBlocks.map((block) => (
              <div class="bg-primary-800 p-8 rounded-lg border-2 border-secondary-500/20 hover:border-secondary-500/40 transition-colors">
                <h3 class="text-xl md:text-2xl font-bold text-secondary-400 mb-4">
                  {block.title}
                </h3>
                <p class="text-white/80 text-base md:text-lg">
                  {block.body}
                </p>
              </div>
            ))}
          </div>

          <div class="text-center">
            <a
              href={primaryCta.href}
              class="inline-block px-8 py-4 bg-secondary-500 hover:bg-secondary-600 text-primary-900 font-bold rounded-lg transition-colors text-lg"
              onclick={`if(typeof gtag !== 'undefined') { gtag('event', 'cta_click', { page: 'landing_clarity_check', location: 'outcome' }); }`}
            >
              {primaryCta.label}
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- FAQ Section -->
    {faq.length > 0 && (
      <section class="py-16 md:py-24 bg-primary-950">
        <div class="container mx-auto px-4 max-w-4xl">
          <div class="mb-12 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
              Frequently Asked Questions
            </h2>
          </div>

          <div class="space-y-4">
            {faq.map((item, index) => (
              <div class="bg-primary-900 rounded-lg overflow-hidden">
                <details class="group" {...(index === 0 ? { open: true } : {})}>
                  <summary class="flex items-center justify-between p-6 cursor-pointer">
                    <h3 class="text-lg font-semibold text-white pr-8">
                      {item.question}
                    </h3>
                    <span class="ml-6 flex-shrink-0 text-secondary-500 group-open:rotate-45 transition-transform">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                        />
                      </svg>
                    </span>
                  </summary>
                  <div class="p-6 pt-0 text-white/80 text-base md:text-lg">
                    {item.answer}
                  </div>
                </details>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Final CTA Section -->
    <section class="py-16 md:py-24 bg-gradient-to-b from-primary-900 to-primary-800">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6">
          Ready to get started?
        </h2>
        <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
          Take the first step towards financial clarity.
        </p>
        <a
          href={primaryCta.href}
          class="inline-block px-8 py-4 bg-secondary-500 hover:bg-secondary-600 text-primary-900 font-bold rounded-lg transition-colors text-lg"
          onclick={`if(typeof gtag !== 'undefined') { gtag('event', 'cta_click', { page: 'landing_clarity_check', location: 'bottom' }); }`}
        >
          {primaryCta.label}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Ensure smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
  }

  /* Custom details/summary styles */
  details > summary {
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
