---
import { CALENDLY_URL } from "../../config/links";
---

<section id="what-we-fix" class="py-12 bg-primary-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div 
        class="text-left mb-12 opacity-0 translate-y-8 transition-all duration-700 ease-out"
        data-animate="header"
      >
        <h2 class="text-secondary-400 text-3xl md:text-4xl font-heading mb-4 font-bold">What We Fix</h2>
        <p class="text-xl max-w-3xl text-white">
          The blind spots that show up when a founder-led business outgrows the way it was run.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="0"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Disconnected Systems</h3>
            <p class="text-white">
              Finance, ops, HR, and payroll don't talk to each other. We connect the dots.
            </p>
          </div>
        </div>
        
        <!-- Card 2 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="1"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Bank-Balance Visibility</h3>
            <p class="text-white">
              You check the balance every morning and call it visibility. We give you numbers you can actually steer with.
            </p>
          </div>
        </div>
        
        <!-- Card 3 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="2"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Late Books</h3>
            <p class="text-white">
              The close lands on the 20th — or the 30th. We get you a clean, on-time close in 30 days.
            </p>
          </div>
        </div>
        
        <!-- Card 4 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="3"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Surprises That Blindside You</h3>
            <p class="text-white">
              A tax bill, a contract clause, a payroll issue. We catch them before they cost you.
            </p>
          </div>
        </div>
        
        <!-- Card 5 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="4"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">You Don't Know What It's Worth</h3>
            <p class="text-white">
              You have a number in your head. We give you one backed by clean books and real margins.
            </p>
          </div>
        </div>
        
        <!-- Card 6 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="5"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">You're the Only One Who Knows</h3>
            <p class="text-white">
              You approve things you shouldn't and sit in meetings you shouldn't. We build the team that takes it off your plate.
            </p>
          </div>
        </div>
      </div>
      
      <div 
        class="text-center mt-16 mb-8 pb-12 border-b border-secondary-400 opacity-0 translate-y-8 transition-all duration-700 ease-out"
        data-animate="cta-section"
      >
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-secondary-400">Want to see what's actually under the hood?</h2>
        <p class="text-2xl text-white mb-10">Let's take a look at your numbers, no strings attached.</p>
        <a href={CALENDLY_URL} class="inline-block bg-primary-700 hover:bg-primary-600 text-white font-bold py-4 px-8 rounded-lg transition-colors shadow-lg text-lg hover:scale-105 transform">
          Book a Call
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initScrollAnimations } from '../../utils/scrollAnimations.js';
  
  // Initialize animations when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initScrollAnimations();
    });
  } else {
    initScrollAnimations();
  }
</script>

<style>
  /* Shared animation styles */
  [data-animate] {
    will-change: transform, opacity;
    transform: translateZ(0); /* Force hardware acceleration */
  }
  
  [data-animate]:not(.opacity-0) {
    will-change: auto;
  }

  /* Accessibility: Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
    
    [data-animate]:hover {
      transform: scale(1);
      filter: brightness(1.05);
    }
  }

  /* Enhanced card hover effects */
  [data-animate="grid-item"]:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.3);
  }

  /* CTA button pulse effect - renamed to avoid conflict with PulseBeams */
  [data-animate="cta-section"] a:hover {
    animation: cta-pulse 2s infinite;
  }

  @keyframes cta-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  /* Keep original card colors - remove custom gradients that override bg-primary-700 */
</style>
