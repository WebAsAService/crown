---

<section id="what-we-fix" class="py-12 bg-primary-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div 
        class="text-left mb-12 opacity-0 translate-y-8 transition-all duration-700 ease-out"
        data-animate="header"
      >
        <h2 class="text-secondary-400 text-3xl md:text-4xl font-heading mb-4 font-bold">What We Fix</h2>
        <p class="text-xl max-w-3xl text-white">
          Practical solutions for the financial challenges growing startups face
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="0"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Broken Systems</h3>
            <p class="text-white">
              Disconnected tools, messy handoffs. We clean up your tech stack and workflows.
            </p>
          </div>
        </div>
        
        <!-- Card 2 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="1"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">No Financial Narrative</h3>
            <p class="text-white">
              You're growing, but the numbers don't tell a story. We build clarity for you and your board.
            </p>
          </div>
        </div>
        
        <!-- Card 3 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="2"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Manual Chaos</h3>
            <p class="text-white">
              Delayed closes, payroll fire drills, no dashboards. We automate the tedious work.
            </p>
          </div>
        </div>
        
        <!-- Card 4 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="3"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Compliance Gaps</h3>
            <p class="text-white">
              Audits, investor decks, tax filings. We bring order before they become problems.
            </p>
          </div>
        </div>
        
        <!-- Card 5 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="4"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Burn Anxiety</h3>
            <p class="text-white">
              Runway is murky. Margins feel off. We help optimize cost structure and protect cash.
            </p>
          </div>
        </div>
        
        <!-- Card 6 -->
        <div 
          class="bg-primary-700 rounded-lg overflow-hidden shadow-lg opacity-0 scale-95 translate-y-4 transition-all duration-500 ease-out hover:scale-105 hover:shadow-xl"
          data-animate="grid-item"
          data-index="5"
        >
          <!-- <img src="https://placehold.co/600x400/grey/FFFFFF?text=Crown" alt="Placeholder" class="w-full h-48 object-cover" /> -->
          <div class="p-6 bg-primary-700">
            <h3 class="text-secondary-400 text-xl font-bold mb-3">Ops Bottlenecks</h3>
            <p class="text-white">
              People waiting on numbers. Founders approving invoices. We fix process so you can scale.
            </p>
          </div>
        </div>
      </div>
      
      <div 
        class="text-center mt-16 mb-8 pb-12 border-b border-secondary-400 opacity-0 translate-y-8 transition-all duration-700 ease-out"
        data-animate="cta-section"
      >
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-secondary-400">Want to get a financial diagnosis?</h2>
        <p class="text-2xl text-white mb-10">Let's take a look under the hood, no strings attached.</p>
        <a href="https://calendly.com/mhachicha-crownacquisitiongroup" class="inline-block bg-primary-700 hover:bg-primary-600 text-white font-bold py-4 px-8 rounded-lg transition-colors shadow-lg text-lg hover:scale-105 transform">
          Book a Call
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initScrollAnimations } from '../../utils/scrollAnimations.js';
  
  // Initialize animations when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initScrollAnimations();
    });
  } else {
    initScrollAnimations();
  }
</script>

<style>
  /* Shared animation styles */
  [data-animate] {
    will-change: transform, opacity;
    transform: translateZ(0); /* Force hardware acceleration */
  }
  
  [data-animate]:not(.opacity-0) {
    will-change: auto;
  }

  /* Accessibility: Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
    
    [data-animate]:hover {
      transform: scale(1);
      filter: brightness(1.05);
    }
  }

  /* Enhanced card hover effects */
  [data-animate="grid-item"]:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.3);
  }

  /* CTA button pulse effect - renamed to avoid conflict with PulseBeams */
  [data-animate="cta-section"] a:hover {
    animation: cta-pulse 2s infinite;
  }

  @keyframes cta-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  /* Keep original card colors - remove custom gradients that override bg-primary-700 */
</style>
