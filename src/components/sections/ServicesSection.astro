---
import { Image } from "astro:assets";
import checkGoldSvg from "../../assets/check-gold.svg";
import fractionalCfoIcon from "../../assets/services/fractional_cfo_for_startups.png";
import accountingIcon from "../../assets/services/accounting_bookkeping.png";
import hrPayrollIcon from "../../assets/services/hr_payroll_support.png";
import workflowIcon from "../../assets/services/workflow_system_automation.png";
import auditComplianceIcon from "../../assets/services/audit_compliance_prep.png";
import capitalFundraisingIcon from "../../assets/services/capital_fundraising_support.png";
---

<section
  id="services"
  class="bg-gradient-to-b from-secondary-50 to-secondary-50"
>
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto border-t border-primary-700 pt-12">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-heading mb-4 text-primary-900 font-bold"
        >
          One Firm. Five Functions. Everything Connected.
        </h2>
        <p class="text-xl text-secondary-500 max-w-3xl mx-auto">
          Fractional CFO plus a full back office — Finance, Operations, HR,
          Legal, and Technology. Most firms touch one. We connect all five.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service Card 1 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            Fractional CFO
          </h3>
          <p class="text-primary-900 mb-4">
            Strategic finance leadership — cash flow, margins, pricing, and the
            numbers behind your biggest decisions — without the full-time cost.
            Structure and insight when it matters most.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Strategic financial planning</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Numbers you can steer with</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Margin & cash visibility</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={fractionalCfoIcon}
              alt="Fractional CFO Services"
              class="h-full opacity-20"
            />
          </div>
        </div>

        <!-- Service Card 2 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            Accounting & Bookkeeping
          </h3>
          <p class="text-primary-900 mb-4">
            Month-end close, reconciliations, and clean financial statements —
            done fast, with no founder follow-up. A clean, on-time close by day
            30.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Accurate financial statements</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Streamlined month-end close</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Dedicated accounting team</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={accountingIcon}
              alt="Accounting & Bookkeeping Services"
              class="h-full opacity-20"
            />
          </div>
        </div>

        <!-- Service Card 3 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            HR & Payroll Support
          </h3>
          <p class="text-primary-900 mb-4">
            From onboarding to compliance, your team is supported and your
            records are spotless — payroll that just runs.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Streamlined onboarding</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Compliance management</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Payroll administration</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={hrPayrollIcon}
              alt="HR & Payroll Support Services"
              class="h-full opacity-20"
            />
          </div>
        </div>

        <!-- Service Card 4 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            Workflow & Systems Automation
          </h3>
          <p class="text-primary-900 mb-4">
            We connect your stack, kill the manual work, and set up reporting
            that runs itself — so the back office stops depending on you.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>System integration</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Process automation</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Automated reporting</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={workflowIcon}
              alt="Workflow & Systems Automation Services"
              class="h-full opacity-20"
            />
          </div>
        </div>

        <!-- Service Card 5 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            Audit & Compliance Prep
          </h3>
          <p class="text-primary-900 mb-4">
            Avoid last-minute scrambles. We keep you audit-ready, buyer-ready,
            and clean — so a surprise never turns into a problem.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Audit preparation</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Regulatory compliance</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Clean, organized records</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={auditComplianceIcon}
              alt="Audit & Compliance Prep Services"
              class="h-full opacity-20"
            />
          </div>
        </div>

        <!-- Service Card 6 -->
        <div
          class="bg-white p-8 rounded-lg shadow-md border border-secondary-200 hover:shadow-xl hover:border-secondary-300 transition-all relative"
        >
          <h3 class="text-2xl font-bold mb-3 text-primary-900">
            Value & Exit Readiness
          </h3>
          <p class="text-primary-900 mb-4">
            Thinking about selling in the next few years? We get your books,
            contracts, and metrics to a place where the number holds up in the
            room.
          </p>
          <ul class="space-y-2 text-primary-900">
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Clean, defensible books</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Business valuation support</span>
            </li>
            <li class="flex items-start">
              <Image
                src={checkGoldSvg}
                alt="Bullet"
                width={24}
                height={24}
                class="h-6 w-6 mr-2 flex-shrink-0"
              />
              <span>Buyer & data-room ready</span>
            </li>
          </ul>
          <div class="absolute top-0 right-0 h-full">
            <Image
              src={capitalFundraisingIcon}
              alt="Value & Exit Readiness Services"
              class="h-full opacity-20"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Gradient transition at the end -->
  <div
    class="h-60 bg-gradient-to-b from-secondary-50 via-primary-800 to-primary-900"
  >
  </div>
</section>
