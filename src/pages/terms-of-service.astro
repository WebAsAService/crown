---
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

// Set Crown client theme - using custom Crown theme
const clientTheme = "theme-crown-new";
---

<Layout
  title="Terms of Service - Crown Acquisition Group"
  description="Terms of Service for Crown Acquisition Group - Our terms and conditions for using our website and services."
  clientTheme={clientTheme}
>
  <Header
    logo="/images/clients/crown/crown.png"
    bgColor="bg-primary-800"
    textColor="text-secondary-400"
    hoverColor="text-secondary-700"
    showFontsLink={false}
  />

  <main>
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <h1 class="text-4xl font-bold text-primary-800 mb-8">Terms of Service</h1>
        
        <div class="text-gray-700 space-y-6">
          <p class="text-sm italic">Last updated: [Insert Date]</p>
          
          <p>Welcome to Crown Acquisition Group ("Crown", "we", "our", or "us"). These Terms of Service ("Terms") govern your access to and use of our website, services, and any content provided by us (collectively, the "Services").</p>
          
          <p>By accessing or using our Services, you agree to be bound by these Terms. If you do not agree to these Terms, please do not use our Services.</p>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">1. Use of Services</h2>
            <p>You agree to use the Services only for lawful purposes and in accordance with these Terms. You may not use our website or services:</p>
            <ul class="list-disc pl-5 mt-2 space-y-2">
              <li>In any way that violates applicable laws or regulations</li>
              <li>To exploit or harm others</li>
              <li>To send unauthorized promotional material or spam</li>
              <li>To interfere with the proper operation of our Services</li>
            </ul>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">2. Intellectual Property</h2>
            <p>All content on this site — including text, graphics, logos, and service descriptions — is the property of Crown Acquisition Group and protected by applicable intellectual property laws. You may not reproduce, distribute, or modify any part of the website without our written consent.</p>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">3. Service Engagements</h2>
            <p>Any engagement for fractional CFO, finance, compliance, or related services will be governed by a separate written agreement outlining the scope, fees, and deliverables. These Terms apply to general website use and marketing material only.</p>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">4. No Guarantees</h2>
            <p>While we strive to provide accurate and valuable information, we make no guarantees regarding business outcomes, financial results, or fundraising success. Each startup's situation is unique and subject to external factors.</p>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">5. Third-Party Links</h2>
            <p>Our website may contain links to third-party sites. We are not responsible for the content, privacy practices, or accuracy of third-party websites.</p>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">6. Limitation of Liability</h2>
            <p>To the fullest extent permitted by law, Crown Acquisition Group shall not be liable for any indirect, incidental, special, or consequential damages resulting from your use of the Services.</p>
          </div>
          
          <div>
            <h2 class="text-2xl font-semibold text-primary-700 mt-8 mb-4">7. Changes to These Terms</h2>
            <p>We may update these Terms from time to time. Any changes will be posted on this page with an updated revision date. Continued use of the site after changes constitutes acceptance of the new terms.</p>
          </div>
          
          <div class="mt-10 border-t border-gray-200 pt-8">
            <h2 class="text-2xl font-semibold text-primary-700 mb-4">8. Contact Us</h2>
            <p>If you have questions about these Terms, please contact:</p>
            <p class="mt-2 font-semibold">Crown Acquisition Group</p>
            <p class="mt-1">📍 West Hollywood, CA</p>
            <p>📧 info@crownag.com</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>