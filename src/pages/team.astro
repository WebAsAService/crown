---
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import { CALENDLY_URL } from "../config/links";

// Set Crown client theme - matches the landing page
const clientTheme = "theme-crown-new";

/*
  TEAM ROSTER — updated per Mohamed's copy notes (Jul 29 2026).
  Split into two groups: day-to-day operators (`team`) and the
  `advisors` (board-level, not day-to-day). Adnane moved from `team`
  into `advisors`; LaCour Miller added as a new board advisor.

  Bios sourced from each person's LinkedIn / self-provided copy and
  condensed into Crown's voice. Photos in `public/images/team/` (256px,
  sharp-resized). Czarla has no LinkedIn profile, so no button renders
  for her.
*/
const team = [
  {
    name: "Mohamed Hachicha",
    role: "Founder & Strategic CFO",
    pillar: "Finance",
    bio:
      "20+ years across Wall Street, fintech, SaaS, and healthcare — including roles at Morgan Stanley, VP of Finance posts in software, and Managing Director of an investment fund in Warsaw. Mohamed built Crown for the founder he kept meeting at the table: someone who built a real business but never had the finance function the big companies take for granted. BBA, George Washington University. Based in LA.",
    linkedin: "https://www.linkedin.com/in/mohamed-hachicha-crown/",
    image: "/images/team/mohamed.jpg",
  },
  {
    name: "Michael Loria",
    role: "Technology & Security Advisor",
    pillar: "Technology",
    bio:
      "A seasoned CISO specializing in AWS and Azure cloud architecture, security, and compliance. Michael has led IT, DevOps, and Security teams, spearheaded a company's first HITRUST certification, built robust cybersecurity frameworks, and architected scalable SaaS platforms from inception to launch. At Crown he owns the technology and security node — keeping client systems integrated, automated, and protected.",
    linkedin: "https://www.linkedin.com/in/michaelloria/",
    image: "/images/team/michael.jpg",
  },
  {
    name: "Peter Prucnel",
    role: "People, HR & Integration Advisor",
    pillar: "People & Integration Operations",
    bio:
      "A process-driven Human Resources executive and M&A integration expert. Peter builds high-performance teams, leads organizational change, and becomes the trusted advisor at every level of a growing business. He owns Crown's people and HR node — onboarding, compliance, and the systems that keep teams engaged and performing as the company scales.",
    linkedin: "https://www.linkedin.com/in/peterprucnel/",
    image: "/images/team/peter.jpg",
  },
  {
    name: "Czarla David",
    role: "Accounting & Delivery Lead",
    pillar: "Operations & Delivery",
    bio:
      "Crown's Accounting and Delivery Lead, Czarla partners with clients to strengthen their finance functions and run accounting operations that just work. She owns engagements end to end — onboarding, month-end close, reporting, and process improvement — so founders get accurate, timely numbers they can act on. With 10+ years across accounting, audit, and financial operations (from early-stage to established companies), she builds the scalable back-office processes that support real growth.",
    linkedin: "",
    image: "/images/team/czarla.jpg",
  },
];

const advisors = [
  {
    name: "Adnane Charchour",
    role: "Strategic Advisor & Board Member",
    pillar: "Strategy & Advisory",
    bio:
      "An award-winning chief executive, board member, and private investor with 25+ years in executive leadership and entrepreneurship across SaaS, fintech, and cybersecurity. Adnane has raised $60M+ in capital, created $100M+ in shareholder value, and led high-growth companies onto the Deloitte Technology Fast 500 and the Inc. 5000 — scaling teams past 250 people. He advises Crown on corporate strategy, capital, and the high-stakes decisions founders face as they grow.",
    linkedin: "https://www.linkedin.com/in/adnanecharchour/",
    image: "/images/team/adnane.jpg",
  },
  {
    name: "LaCour Miller",
    role: "Board Advisor, Specialty Finance",
    pillar: "Risk & Specialty Finance",
    bio:
      "Managing Director of Specialty Finance at Always.Bank, LaCour has built his career on SMB risk management across fintech and traditional lending. His focus is accounts receivable financing and other forms of asset based lending, work that depends on reading risk correctly and building teams that can act on it. A graduate of Tulane University's A.B. Freeman School of Business, based in the Greater New Orleans region, he advises Crown on risk and specialty finance so founders get the same discipline applied to their own businesses.",
    linkedin: "https://www.linkedin.com/in/lacour-miller-214a0721/",
    image: "/images/team/lacour.jpg",
  },
];
---

<Layout
  title="Our Team — Crown Acquisition Group"
  clientTheme={clientTheme}
>
  <Header
    logo="/images/clients/crown/crown.png"
    bgColor="bg-primary-800"
    textColor="text-secondary-400"
    hoverColor="text-secondary-700"
    showFontsLink={false}
  />

  <main>
    <!-- Intro / What we do -->
    <section class="bg-gradient-to-b from-primary-800 to-primary-900 text-white pt-20 pb-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-heading font-bold text-secondary-400 mb-6">
            The people behind your numbers.
          </h1>
          <p class="text-xl md:text-2xl text-white/90">
            Crown brings together experienced operators across Finance,
            Operations, HR, Legal, and Technology. Each leads a different
            function, but they work as one team around your business. Here
            are the people doing the work.
          </p>
        </div>
      </div>
    </section>

    <!-- Five pillars -->
    <section class="bg-primary-900 pb-8">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="pillar-grid text-center">
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Finance</h3>
              <p class="text-white/80 text-sm">CFO strategy, close, reporting</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Operations</h3>
              <p class="text-white/80 text-sm">Systems, workflow, automation</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">HR</h3>
              <p class="text-white/80 text-sm">Payroll, onboarding, compliance</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Legal</h3>
              <p class="text-white/80 text-sm">Risk, contracts, audit-ready</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Technology</h3>
              <p class="text-white/80 text-sm">Stack, data, secure systems</p>
            </div>
          </div>
          <p class="text-center text-white/70 mt-6 text-lg">
            Five functions. One connected team.
          </p>
        </div>
      </div>
    </section>

    <!-- Team grid -->
    <section id="team" class="py-16 bg-primary-900">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-400 mb-4">
              The people who connect the dots.
            </h2>
            <p class="text-xl text-white/80 max-w-3xl mx-auto">
              Experienced operators working across finance, operations, and the back office as one team.
            </p>
          </div>

          <div class="carousel-frame" data-carousel-frame>
            <div class="team-carousel lg:grid lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0" data-carousel>
              {
                team.map((member) => (
                  <div class="team-card bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow flex flex-col">
                    <div class="text-center flex-grow">
                      <div class="w-32 h-32 mb-4 mx-auto">
                        <div class="bg-gray-200 w-full h-full rounded-full flex items-center justify-center overflow-hidden">
                          {member.image ? (
                            <img
                              src={member.image}
                              alt={member.name}
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="h-16 w-16 text-gray-400"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                          )}
                        </div>
                      </div>
                      <h3 class="text-xl font-bold mb-1 text-primary-900">{member.name}</h3>
                      <p class="text-secondary-600 font-medium mb-1">{member.role}</p>
                      <p class="text-xs uppercase tracking-[0.15em] text-gray-400 mb-3">{member.pillar}</p>
                      <p class="text-gray-600 mb-4 text-sm leading-relaxed text-left lg:text-[13px] xl:text-sm">
                        {member.bio}
                      </p>
                    </div>
                    {member.linkedin && (
                      <div class="text-center mt-auto">
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center bg-primary-800 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors text-sm"
                        >
                          <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                          </svg>
                          LinkedIn
                        </a>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            <button class="carousel-next" type="button" aria-label="Show more team members" data-carousel-next>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <div class="text-center mt-16">
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-secondary-500 hover:bg-secondary-600 text-primary-900 font-semibold py-3 px-8 rounded-lg transition-colors"
            >
              Talk to the team
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Board of Advisors -->
    <section id="advisors" class="py-16 bg-primary-800 border-t border-primary-700">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-400 mb-4">
              Board of Advisors
            </h2>
            <p class="text-xl text-white/80 max-w-3xl mx-auto">
              Senior voices Crown draws on for the decisions that matter most.
            </p>
          </div>

          <div class="carousel-frame advisors-frame" data-carousel-frame>
            <div class="team-carousel advisors-carousel lg:grid lg:grid-cols-2 lg:max-w-3xl lg:mx-auto lg:gap-8 lg:overflow-visible lg:px-0 lg:pb-0" data-carousel>
              {
                advisors.map((member) => (
                  <div class="team-card bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow flex flex-col">
                    <div class="text-center flex-grow">
                      <div class="w-32 h-32 mb-4 mx-auto">
                        <div class="bg-gray-200 w-full h-full rounded-full flex items-center justify-center overflow-hidden">
                          {member.image ? (
                            <img
                              src={member.image}
                              alt={member.name}
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="h-16 w-16 text-gray-400"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                          )}
                        </div>
                      </div>
                      <h3 class="text-xl font-bold mb-1 text-primary-900">{member.name}</h3>
                      <p class="text-secondary-600 font-medium mb-1">{member.role}</p>
                      <p class="text-xs uppercase tracking-[0.15em] text-gray-400 mb-3">{member.pillar}</p>
                      <p class="text-gray-600 mb-4 text-sm leading-relaxed text-left">
                        {member.bio}
                      </p>
                    </div>
                    {member.linkedin && (
                      <div class="text-center mt-auto">
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center bg-primary-800 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors text-sm"
                        >
                          <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                          </svg>
                          LinkedIn
                        </a>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            <button class="carousel-next" type="button" aria-label="Show more advisors" data-carousel-next>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.querySelectorAll("[data-carousel-frame]").forEach((frame) => {
    const carousel = frame.querySelector("[data-carousel]");
    const nextButton = frame.querySelector("[data-carousel-next]");

    if (!(carousel instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement)) {
      return;
    }

    const updateButton = () => {
      nextButton.hidden = carousel.scrollWidth <= carousel.clientWidth + 8;
    };

    nextButton.addEventListener("click", () => {
      const atEnd = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 8;
      carousel.scrollTo({
        left: atEnd ? 0 : carousel.scrollLeft + carousel.clientWidth * 0.86,
        behavior: "smooth",
      });
    });

    window.addEventListener("resize", updateButton);
    updateButton();
  });
</script>

<style>
  .pillar-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .pillar-card {
    flex: 0 1 calc(50% - 0.5rem);
    max-width: calc(50% - 0.5rem);
    min-height: 8.25rem;
  }

  .carousel-frame {
    position: relative;
  }

  .team-carousel {
    display: flex;
    gap: 1rem;
    margin-inline: -1rem;
    overflow-x: auto;
    padding-inline: 1rem;
    padding-bottom: 1rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .team-carousel::after {
    content: "";
    flex: 0 0 2.75rem;
  }

  .team-carousel::-webkit-scrollbar {
    display: none;
  }

  .team-card {
    flex: 0 0 min(84vw, 22rem);
    scroll-snap-align: center;
  }

  .carousel-next {
    align-items: center;
    background: var(--color-secondary-500);
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 9999px;
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.28);
    color: var(--color-primary-900);
    display: flex;
    height: 3rem;
    justify-content: center;
    position: absolute;
    right: -0.25rem;
    top: 38%;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
    width: 3rem;
    z-index: 2;
  }

  .carousel-next:hover,
  .carousel-next:focus-visible {
    background: var(--color-secondary-400);
    transform: translateX(2px);
  }

  .carousel-next svg {
    fill: none;
    height: 1.35rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.25;
    width: 1.35rem;
  }

  .carousel-next[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .pillar-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .pillar-card {
      max-width: none;
      min-height: auto;
    }
  }

  @media (min-width: 1024px) {
    .team-carousel {
      display: grid;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
    }

    .team-carousel::after {
      display: none;
    }

    .advisors-carousel {
      justify-items: center;
    }

    .team-card {
      flex: none;
      min-width: 0;
      width: 100%;
      max-width: none;
    }

    .advisors-carousel .team-card {
      max-width: 22rem;
    }

    .carousel-next {
      display: none;
    }
  }
</style>
