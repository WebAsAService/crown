---
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import { CALENDLY_URL } from "../config/links";

// Set Crown client theme - matches the landing page
const clientTheme = "theme-crown-new";

/*
  TEAM ROSTER — updated per Mohamed's copy notes (Jul 29 2026).
  Split into two groups: day-to-day operators (`team`) and the
  `advisors` (board-level, not day-to-day). Adnane moved from `team`
  into `advisors`; LaCour Miller added as a new board advisor.

  Bios sourced from each person's LinkedIn / self-provided copy and
  condensed into Crown's voice. Photos in `public/images/team/` (256px,
  sharp-resized).
*/
const team = [
  {
    name: "Mohamed Hachicha",
    role: "Founder & Strategic CFO",
    pillar: "Finance",
    bio:
      "Mohamed is Crown's founder and strategic CFO, with more than 20 years across finance, technology, healthcare, and investment management. He built Crown to give growing businesses the financial leadership, operating discipline, and cross-functional support larger companies rely on. He leads client strategy and keeps finance connected to the decisions that drive performance, growth, and long-term value.",
    linkedin: "https://www.linkedin.com/in/mohamed-hachicha-crown/",
    image: "/images/team/mohamed.jpg",
  },
  {
    name: "Michael Loria",
    role: "Technology & Security Advisor",
    pillar: "Technology & Security",
    bio:
      "Michael is a technology and security leader specializing in cloud architecture, cybersecurity, DevOps, and compliance. He has led infrastructure and security teams, built scalable SaaS platforms, and guided complex security initiatives. At Crown, he helps clients design secure, integrated systems that support growth, protect data, and reduce operational friction as the business becomes more complex.",
    linkedin: "https://www.linkedin.com/in/michaelloria/",
    image: "/images/team/michael.jpg",
  },
  {
    name: "Peter Prucnel",
    role: "People & Integration Advisor",
    pillar: "People & Integration",
    bio:
      "Peter is a people and integration leader with deep experience across human resources, M&A integration, organizational change, and executive advisory. He helps companies align teams, compensation, onboarding, compliance, and operating rhythms as the business becomes more complex. At Crown, he brings the people perspective that turns financial and operational decisions into stronger teams and cleaner execution.",
    linkedin: "https://www.linkedin.com/in/peterprucnel/",
    image: "/images/team/peter.jpg",
  },
  {
    name: "Czarla David",
    role: "General Manager",
    pillar: "Accounting & Delivery",
    bio:
      "Czarla is Crown's general manager and accounting delivery lead, overseeing client onboarding, month-end close, reporting, and process improvement. She brings more than 10 years across accounting, audit, and financial operations. At Crown, she keeps engagements moving from cleanup to ongoing delivery, making sure clients receive accurate numbers, consistent communication, and back-office processes they can rely on.",
    linkedin: "https://www.linkedin.com/in/czarla-marie-valencia-29aa862b2/",
    image: "/images/team/czarla.jpg",
  },
];

const advisors = [
  {
    name: "Adnane Charchour",
    role: "Strategic Advisor & Board Member",
    pillar: "Strategy & Advisory",
    bio:
      "Adnane is an executive leader, board member, and private investor with 25+ years across SaaS, fintech, and cybersecurity. He has raised $60M+ in capital, created $100M+ in shareholder value, and led companies onto the Deloitte Technology Fast 500 and Inc. 5000. He advises Crown on strategy, capital, growth decisions, and the operating discipline companies need as they scale.",
    linkedin: "https://www.linkedin.com/in/adnanecharchour/",
    image: "/images/team/adnane.jpg",
  },
  {
    name: "LaCour Miller",
    role: "Advisory Board, Specialty Finance",
    pillar: "Risk & Specialty Finance",
    bio:
      "LaCour is Managing Director of Specialty Finance at Always Bank, where his work focuses on SMB risk management, accounts receivable financing, and asset-based lending. Separately, he serves on Crown's Advisory Board as an individual advisor, bringing perspective on credit, risk, and specialty finance. Crown also maintains a commercial partnership with Always Bank, which is distinct from LaCour's advisory role.",
    linkedin: "https://www.linkedin.com/in/lacour-miller-214a0721/",
    image: "/images/team/lacour.jpg",
  },
];
---

<Layout
  title="Our Team — Crown Acquisition Group"
  clientTheme={clientTheme}
>
  <Header
    logo="/images/clients/crown/crown.png"
    bgColor="bg-primary-800"
    textColor="text-secondary-400"
    hoverColor="text-secondary-700"
    showFontsLink={false}
  />

  <main>
    <!-- Intro / What we do -->
    <section class="bg-gradient-to-b from-primary-800 to-primary-900 text-white pt-20 pb-16">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl lg:whitespace-nowrap font-heading font-bold text-secondary-400 mb-6">
            The people who connect the dots.
          </h1>
          <p class="text-xl md:text-2xl text-white/90">
            Crown brings together experienced operators across Finance,
            Operations, HR, Legal, and Technology. Each leads a different
            function, but they work together around the same business
            priorities.
          </p>
        </div>
      </div>
    </section>

    <!-- Five pillars -->
    <section class="bg-primary-900 pb-8">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="pillar-grid text-center">
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Finance</h3>
              <p class="text-white/80 text-sm">Strategy, forecasting, close, reporting</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Operations</h3>
              <p class="text-white/80 text-sm">Processes, controls, workflows, automation</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">HR</h3>
              <p class="text-white/80 text-sm">Payroll, benefits, onboarding, compliance</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Legal</h3>
              <p class="text-white/80 text-sm">Contracts, governance, risk management</p>
            </div>
            <div class="pillar-card bg-primary-700 rounded-lg p-5">
              <h3 class="text-secondary-400 font-bold mb-1">Technology</h3>
              <p class="text-white/80 text-sm">Systems, data, integrations, security</p>
            </div>
          </div>
          <p class="text-center text-white/70 mt-6 text-lg">
            Five functions. One connected team.
          </p>
        </div>
      </div>
    </section>

    <!-- Team grid -->
    <section id="team" class="pt-8 pb-16 bg-primary-900">
      <div class="container mx-auto px-4">
        <div class="max-w-7xl mx-auto">
          <div class="carousel-frame" data-carousel-frame>
            <div class="team-carousel lg:grid lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0" data-carousel>
              {
                team.map((member) => (
                  <div class="team-card bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow flex flex-col">
                    <div class="text-center flex-grow">
                      <div class="w-32 h-32 mb-4 mx-auto">
                        <div class="bg-gray-200 w-full h-full rounded-full flex items-center justify-center overflow-hidden">
                          {member.image ? (
                            <img
                              src={member.image}
                              alt={member.name}
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="h-16 w-16 text-gray-400"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                          )}
                        </div>
                      </div>
                      <h3 class="text-xl font-bold mb-1 text-primary-900">{member.name}</h3>
                      <p class="text-secondary-600 font-medium mb-1">{member.role}</p>
                      <p class="text-xs tracking-[0.15em] text-gray-400 mb-3">{member.pillar}</p>
                      <p class="text-gray-600 mb-4 text-sm leading-relaxed text-left lg:text-[13px] xl:text-sm">
                        {member.bio}
                      </p>
                    </div>
                    {member.linkedin && (
                      <div class="text-center mt-auto">
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center bg-primary-800 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors text-sm"
                        >
                          <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                          </svg>
                          LinkedIn
                        </a>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            <button class="carousel-next" type="button" aria-label="Show more team members" data-carousel-next>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <div class="text-center mt-16">
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-secondary-500 hover:bg-secondary-600 text-primary-900 font-semibold py-3 px-8 rounded-lg transition-colors"
            >
              Talk with Crown
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Advisory Board -->
    <section id="advisors" class="py-16 bg-primary-800 border-t border-primary-700">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-400 mb-4">
              Advisory Board
            </h2>
            <p class="text-xl text-white/80 max-w-3xl mx-auto">
              Experienced executives who advise Crown on strategy, capital,
              risk, and growth.
            </p>
          </div>

          <div class="carousel-frame advisors-frame" data-carousel-frame>
            <div class="team-carousel advisors-carousel lg:grid lg:grid-cols-2 lg:max-w-3xl lg:mx-auto lg:gap-8 lg:overflow-visible lg:px-0 lg:pb-0" data-carousel>
              {
                advisors.map((member) => (
                  <div class="team-card bg-white rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow flex flex-col">
                    <div class="text-center flex-grow">
                      <div class="w-32 h-32 mb-4 mx-auto">
                        <div class="bg-gray-200 w-full h-full rounded-full flex items-center justify-center overflow-hidden">
                          {member.image ? (
                            <img
                              src={member.image}
                              alt={member.name}
                              class="w-full h-full object-cover"
                            />
                          ) : (
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="h-16 w-16 text-gray-400"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                          )}
                        </div>
                      </div>
                      <h3 class="text-xl font-bold mb-1 text-primary-900">{member.name}</h3>
                      <p class="text-secondary-600 font-medium mb-1">{member.role}</p>
                      <p class="text-xs tracking-[0.15em] text-gray-400 mb-3">{member.pillar}</p>
                      <p class="text-gray-600 mb-4 text-sm leading-relaxed text-left">
                        {member.bio}
                      </p>
                    </div>
                    {member.linkedin && (
                      <div class="text-center mt-auto">
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center bg-primary-800 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors text-sm"
                        >
                          <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                          </svg>
                          LinkedIn
                        </a>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            <button class="carousel-next" type="button" aria-label="Show more advisors" data-carousel-next>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.querySelectorAll("[data-carousel-frame]").forEach((frame) => {
    const carousel = frame.querySelector("[data-carousel]");
    const nextButton = frame.querySelector("[data-carousel-next]");

    if (!(carousel instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement)) {
      return;
    }

    const updateButton = () => {
      nextButton.hidden = carousel.scrollWidth <= carousel.clientWidth + 8;
    };

    nextButton.addEventListener("click", () => {
      const cards = Array.from(carousel.querySelectorAll(".team-card")).filter(
        (card) => card instanceof HTMLElement,
      );

      if (!cards.length) {
        return;
      }

      const currentIndex = cards.reduce((closestIndex, card, index) => {
        const closestCard = cards[closestIndex];
        const currentDistance = Math.abs(card.offsetLeft - carousel.scrollLeft);
        const closestDistance = Math.abs(closestCard.offsetLeft - carousel.scrollLeft);

        return currentDistance < closestDistance ? index : closestIndex;
      }, 0);
      const nextIndex = currentIndex >= cards.length - 1 ? 0 : currentIndex + 1;

      carousel.scrollTo({
        left: cards[nextIndex].offsetLeft,
        behavior: "smooth",
      });
    });

    window.addEventListener("resize", updateButton);
    updateButton();
  });
</script>

<style>
  .pillar-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .pillar-card {
    flex: 0 1 calc(50% - 0.5rem);
    max-width: calc(50% - 0.5rem);
    min-height: 8.25rem;
  }

  .carousel-frame {
    position: relative;
  }

  .team-carousel {
    display: flex;
    gap: 1rem;
    margin-inline: -1rem;
    overflow-x: auto;
    padding-inline: 1rem;
    padding-bottom: 1rem;
    scroll-padding-inline: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .team-carousel::after {
    content: "";
    flex: 0 0 2.75rem;
  }

  .team-carousel::-webkit-scrollbar {
    display: none;
  }

  .team-card {
    flex: 0 0 min(84vw, 22rem);
    scroll-snap-align: center;
  }

  .carousel-next {
    align-items: center;
    background: var(--color-secondary-500);
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 9999px;
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.28);
    color: var(--color-primary-900);
    display: flex;
    height: 3rem;
    justify-content: center;
    position: absolute;
    right: -0.25rem;
    top: 38%;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
    width: 3rem;
    z-index: 2;
  }

  .carousel-next:hover,
  .carousel-next:focus-visible {
    background: var(--color-secondary-400);
    transform: translateX(2px);
  }

  .carousel-next svg {
    fill: none;
    height: 1.35rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.25;
    width: 1.35rem;
  }

  .carousel-next[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .pillar-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .pillar-card {
      max-width: none;
      min-height: auto;
    }
  }

  @media (min-width: 1024px) {
    .team-carousel {
      display: grid;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
    }

    .team-carousel::after {
      display: none;
    }

    .advisors-carousel {
      justify-items: center;
      margin-inline: auto;
    }

    .team-card {
      flex: none;
      min-width: 0;
      width: 100%;
      max-width: none;
    }

    .advisors-carousel .team-card {
      max-width: 22rem;
    }

    .carousel-next {
      display: none;
    }
  }
</style>
